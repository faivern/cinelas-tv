# Cinelas Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
POSTGRES_USER=cinelas
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=cinelas

# ============================================
# TMDB API
# ============================================
TMDB_API_KEY=your_tmdb_api_key_here

# ============================================
# SIGN-IN (cinelas-tv)
# ============================================
# Household PIN for the TV build. Profiles are defined in
# backend/appsettings.json (Auth:Profiles). No Google OAuth in this fork.
CINELAS_PIN=1234

# ============================================
# JELLYFIN (cinelas-tv)
# ============================================
# Create in Jellyfin admin: Dashboard → API Keys. Empty → playback
# endpoints report everything unavailable (Play buttons hidden).
JELLYFIN_API_KEY=
# Host path holding the media library (movies/, tv/). On the Pi: /media
MEDIA_PATH=./media

# ============================================
# HTTPS DEV CERT (Docker)
# ============================================
ASPNETCORE_HTTPS_PASSWORD=your_pfx_password_here

# ============================================
# PGADMIN (Development only)
# ============================================
PGADMIN_EMAIL=admin@cinelas.com
PGADMIN_PASSWORD=admin
